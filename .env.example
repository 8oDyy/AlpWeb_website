# AlpWeb Website - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# SITE CONFIGURATION
# ===========================================

# Site URL (used for SEO, canonical URLs, sitemap)
NUXT_PUBLIC_SITE_URL=https://alp-web.com

# Site name
NUXT_PUBLIC_SITE_NAME=AlpWeb

# Site description (fallback for pages without custom description)
NUXT_PUBLIC_SITE_DESCRIPTION=Agence web spécialisée dans la création de sites vitrines premium, applications iOS et plateformes sur-mesure.

# Environment: 'production' | 'preview' | 'development'
# - production: full SEO, analytics enabled
# - preview: noindex headers, analytics disabled
# - development: noindex, analytics disabled
NUXT_PUBLIC_ENV=production

# ===========================================
# ANALYTICS (optional)
# ===========================================

# Analytics provider: 'gtag' | 'plausible' | '' (disabled)
NUXT_PUBLIC_ANALYTICS_PROVIDER=

# Google Analytics 4 (if provider = 'gtag')
# NUXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX

# Plausible (if provider = 'plausible')
# NUXT_PUBLIC_PLAUSIBLE_DOMAIN=alp-web.com

# ===========================================
# CONTACT FORM (optional)
# ===========================================

# Email for contact form submissions
# NUXT_CONTACT_EMAIL=contact@alpweb.fr

# ===========================================
# API KEYS (if needed)
# ===========================================

# Add any API keys here (never commit real values!)
