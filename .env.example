# AlpWeb Website - Environment Variables
# Copy this file to .env and fill in the values

# Site URL (used for SEO and meta tags)
NUXT_PUBLIC_SITE_URL=https://alpweb.fr

# Analytics (optional)
# NUXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX

# Contact form (optional - if using external service)
# NUXT_CONTACT_EMAIL=contact@alpweb.fr
